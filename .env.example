# Copy to .env and fill in. Never commit your real .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: pin the model used by the CLI. Defaults to a current Sonnet.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: point at a different data folder. Defaults to ./data, then ./sample_data.
# EVENTOPS_DATA_DIR=/absolute/path/to/csvs
